DATABASE_URL=
SESSION_SECRET=
ADMIN_KEY=
NODE_ENV=

# Cloudinary (required for beta/prod)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload behavior
ALLOW_LOCAL_UPLOAD_FALLBACK=false

# Client / API configuration
EXPO_PUBLIC_API_URL=

# Stripe (required for payments in production)
# Get these from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# App base URL (used for Stripe success/cancel redirect URLs)
# Set to your deployed domain in production (e.g. https://yourapp.repl.co)
CLIENT_APP_URL=

# Platform take rate (default: 10 if unset)
PLATFORM_FEE_PERCENT=10
